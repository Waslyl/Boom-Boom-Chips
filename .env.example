# Copy to .env for local overrides, or set these in your host's dashboard.

PORT=8080
BBC_HOST=0.0.0.0

# Serve the built client from the same process (one container, one port).
BBC_CLIENT_DIR=client/dist

# REQUIRED IN PRODUCTION. Without it a fresh secret is generated on every boot,
# which silently breaks reconnection across restarts and across replicas.
#   openssl rand -hex 32
BBC_SESSION_SECRET=

# Lock the socket to your own origins once you have a domain.
# BBC_ALLOWED_ORIGINS=https://boomboomchips.example,https://www.boomboomchips.example

# How long a seat is held for a player who dropped, in milliseconds.
BBC_DISCONNECT_GRACE_MS=60000
